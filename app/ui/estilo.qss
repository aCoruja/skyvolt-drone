/* app/ui/estilo.qss */

/* Padronização geral de fonte e fundo */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    background-color: #F8F9FA;
    color: #333333;
}

/* Estilo dos Botões */
QPushButton {
    background-color: #0d6efd;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0b5ed7;
}

QPushButton:pressed {
    background-color: #0a58ca;
}

/* Tabelas e Caixas de entrada */
QTableWidget, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit {
    background-color: white;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 4px;
}
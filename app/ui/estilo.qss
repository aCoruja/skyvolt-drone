/* app/ui/estilo.qss */

/* ---------- Base ---------- */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    color: #374151;
}

QMainWindow, QDialog {
    background-color: #f4f6fa;
}

/* ---------- Cabeçalho do dashboard ---------- */
#headerBar {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4a67a3, stop:1 #6c8fc7);
}

#lblTitulo {
    color: white;
    font-size: 15pt;
    font-weight: bold;
    background: transparent;
}

/* ---------- Cards da barra lateral ---------- */
#painelIndicadores, #scrollIndicadores, #painelIndicadoresConteudo {
    background: transparent;
    border: none;
}

#scrollIndicadores QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
#scrollIndicadores QScrollBar::handle:vertical {
    background: #c7ccd6;
    border-radius: 4px;
    min-height: 24px;
}
#scrollIndicadores QScrollBar::handle:vertical:hover {
    background: #aab1bf;
}
#scrollIndicadores QScrollBar::add-line:vertical, #scrollIndicadores QScrollBar::sub-line:vertical {
    height: 0;
}

QFrame#cardStatus, QFrame#cardTensao, QFrame#cardCorrente,
QFrame#cardPotencia, QFrame#cardQualidade, QFrame#cardModoMedicao,
QFrame#cardConexao, QFrame#cardWifi, QFrame#cardConfigDrone {
    background-color: white;
    border: 1px solid #e3e7ee;
    border-radius: 8px;
    padding: 7px;
}

/* Indicadores primários (Tensão/Corrente/Potência/Status/Qualidade) */
#lblLegendaStatus, #lblLegendaTensao, #lblLegendaCorrente,
#lblLegendaPotencia, #lblLegendaQualidade {
    color: #8b93a1;
    font-size: 8pt;
    font-weight: bold;
    background: transparent;
}

#lblStatusDisjuntor, #lblTensaoValor, #lblCorrenteValor,
#lblPotenciaValor, #lblQualidade {
    font-size: 15pt;
    font-weight: bold;
    background: transparent;
}

/* Modo de medição (garras) */
#lblLegendaModo {
    color: #8b93a1;
    font-size: 8pt;
    font-weight: bold;
    background: transparent;
}
#lblModoMedicao {
    font-size: 12pt;
    font-weight: bold;
    color: #4a67a3;
    background: transparent;
}

/* Conectividade (LoRa / WiFi / Configuração do drone) — cards secundários,
   mais discretos que os indicadores principais */
#lblLegendaConexao, #lblLegendaWifi, #lblLegendaConfigDrone {
    color: #8b93a1;
    font-size: 8pt;
    font-weight: bold;
    background: transparent;
}
#lblStatusConexao, #lblStatusWifi {
    font-size: 10pt;
    font-weight: bold;
    background: transparent;
    padding-top: 2px;
}
#cardConexao QPushButton, #cardWifi QPushButton, #cardConfigDrone QPushButton {
    padding: 6px 10px;
    font-size: 9pt;
    background-color: #7c93bd;
}
#cardConexao QPushButton:hover, #cardWifi QPushButton:hover, #cardConfigDrone QPushButton:hover {
    background-color: #6c83ad;
}
#cardConexao QPushButton:disabled, #cardWifi QPushButton:disabled {
    background-color: #d5d9e0;
    color: #f4f6fa;
}

/* ---------- Títulos de seção (tabela / gráfico) ---------- */
#lblTituloEventos, #lblTituloGrafico {
    font-size: 10pt;
    font-weight: bold;
    color: #4b5563;
    background: transparent;
    padding-top: 4px;
}

/* ---------- Rodapé com os botões principais ---------- */
#footerBar {
    background-color: white;
    border-top: 1px solid #e3e7ee;
}

#btnAlternarDisjuntor {
    background-color: #d9736c;
}
#btnAlternarDisjuntor:hover {
    background-color: #c85f58;
}
#btnAlternarDisjuntor:pressed {
    background-color: #a94a44;
}

/* ---------- Botões (padrão) ---------- */
QPushButton {
    background-color: #5b7fc4;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #4c6db0;
}
QPushButton:pressed {
    background-color: #3f5c99;
}

/* ---------- Tabela de eventos ---------- */
QTableWidget {
    background-color: white;
    alternate-background-color: #f7f8fb;
    border: 1px solid #e3e7ee;
    border-radius: 6px;
    gridline-color: #edeff3;
}
QHeaderView::section {
    background-color: #f1f3f8;
    color: #4b5563;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #e3e7ee;
    font-weight: bold;
}
QTableWidget::item {
    padding: 4px;
}
QTableWidget::item:selected {
    background-color: #dce4f5;
    color: #374151;
}

/* ---------- Caixas de entrada ---------- */
QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit {
    background-color: white;
    border: 1px solid #d7dbe3;
    border-radius: 4px;
    padding: 4px 6px;
}
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid #5b7fc4;
}

/* ---------- Diálogo de configurações ---------- */
#lblTituloDialog {
    font-size: 12pt;
    font-weight: bold;
    color: #374151;
    background: transparent;
}
